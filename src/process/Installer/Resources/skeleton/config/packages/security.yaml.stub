providers:
    users:
        memory:
            users: {}

password_hashers:
    default: auto

firewalls:
    assets:
        pattern: ^/builds/
        security: false
    main:
        pattern: ^/
        provider: users
        form_login:
            login_path: /login
            enable_csrf: true
        logout:
            path: /logout
            target: /
        remember_me:
            lifetime: 604800
        login_throttling:
            max_attempts: 5
            interval: 60

role_hierarchy:
    ROLE_ADMIN: [ROLE_USER]

access_control: []