{
    "name": "neophp/framework",
    "description": "NeoPHP - an ultra modular PHP framework.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "framework",
        "neophp",
        "yaml",
        "routing",
        "http",
        "twig"
    ],
    "require": {
        "php": ">=8.2"
    },
    "conflict": {
        "twig/twig": "<3.0"
    },
    "suggest": {
        "twig/twig": "Required to render .twig templates (^3.0)",
        "ext-zip": "Required to archive log files as .zip"
    },
    "autoload": {
        "psr-4": {
            "NeoPHP\\Component\\": "src/components/",
            "NeoPHP\\Package\\": "src/packages/",
            "NeoPHP\\Process\\": "src/process/"
        }
    },
    "bin": [
        "bin/neo"
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}